# Pixel Play model settings — copy to .env and edit.
# .env stays on this machine and is gitignored; the browser never sees it.
# Real environment variables override anything set here.

# Backend: auto | jev | chat
PAINT_PROVIDER=auto

# --- Local OpenAI-compatible model (Ollama, LM Studio, vLLM, ...) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2
# Local servers usually ignore the key; set one only if yours requires it.
OPENAI_API_KEY=

# --- Hosted OpenAI-compatible model ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Jev / System One models: TypeSafe's Jev or any 3rd-party Jev-compatible
#     endpoint. Key, model name, and URL are all configurable; the key is
#     optional for endpoints that do not require one. ---
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_API_KEY=

# PORT=8791
